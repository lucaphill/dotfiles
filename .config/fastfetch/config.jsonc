// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "command-raw",
        "source": "sh -c 'pokemon-colorscripts --no-title -n $(shuf -n1 -e vaporeon jolteon flareon espeon umbreon leafeon glaceon sylveon)'",        "padding": {
            "right": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "colors",
            "symbol": "square"
        },
        {
            "key": "{#38}>{#keys}{#32}  Bem vinde luca{#keys}",
            "type": "title",
            "format": " "
        },
        {
            "type": "datetime",
            "format": "{hour-pretty}:{minute-pretty} - {11}/{3}/{1}",
            "key": "{#34} {#keys}",
        },
        {
            "key": " ",
            "type": "custom"
        },
        {
            "key": "{#31} {#keys}",
            "type": "kernel"
        },
        {
            "key": "{#32}󰇄 {#keys}",
            "type": "wm"
        },
        {
            "key": "{#37} {#keys}",
            "type": "os"
        },
        {
            "key": "{#32}󰢮 {#keys}",
            "type": "cpu",
            "format": "{name} @ {freq-max}"
        },
        {
            "key": "{#34}󰅐 {#keys}",
            "type": "uptime"
        },
        {
            "key": "{#36} {#keys}",
            "type": "packages"
        },
        {
            "key": "{#31} {#keys}",
            "type": "terminal"
        },
        {
            "key": "{#32} {#keys}",
            "type": "shell"
        },
        {
            "key": "{#34}󰉉 {#keys}",
            "type": "disk",
            "folders": "/",
            "format": "{size-used} / {size-total} [{size-percentage}]",
        },
        {
            "key": "{#36}󰍛 {#keys}",
            "type": "memory",
            "format": "{used} / {total} [{percentage}]"
        },
        {
            "key": " ",
            "type": "custom"
        },
        {
            "type": "colors",
            "symbol": "square"
        },
    ]
}
