# esse backup não se atualiza sozinho, ele foi feito dia 21/11/26
[accessibility]
ui_scale = 0.90000000596046448

[audio]
enable_overdrive = true
enable_sounds = false

[bar]
order = [ "default", "lyrics", "blocos" ]

    [bar.blocos]
    background_opacity = 0.0
    capsule = true
    capsule_border = "primary"
    capsule_border_width = 2.5
    capsule_opacity = 0.78999998234212399
    capsule_padding = 9.0
    capsule_radius = 8
    capsule_thickness = 0.91999998316168785
    compositor_blur = false
    concave_edge_corners = false
    contact_shadow = true
    enabled = false
    end = [ "lyrics_2", "media", "weather", "privacy", "tray", "group:g3" ]
    font_scale = 0.98999998532235622
    margin_edge = 7
    margin_ends = 0
    start = [ "workspaces", "active_window", "group:g1", "cat_2" ]

        [[bar.blocos.capsule_group]]
        accordion = true
        accordion_direction = "end"
        border = "tertiary"
        border_width = 2.5
        enabled = true
        fill = "surface_container"
        id = "g1"
        members = [ "temp", "sysmon", "ram" ]
        opacity = 0.78999996185302734
        padding = 9.0
        radius = 8.0

        [[bar.blocos.capsule_group]]
        accordion = false
        accordion_direction = "end"
        border = "primary"
        border_width = 2.5
        enabled = true
        fill = "surface_container"
        id = "g3"
        members = [ "status_2", "network", "battery" ]
        opacity = 0.78999996185302734
        padding = 9.0
        radius = 8.0

    [bar.default]
    background_opacity = 0.73999998345971107
    border = "primary"
    border_width = 2.5
    center = [ "weather", "clock" ]
    end = [ "group:g1", "privacy", "status", "tray", "workspaces" ]
    hover_highlight = false
    margin_edge = 6
    margin_ends = 400
    padding = 9
    start = [ "battery", "media" ]

        [[bar.default.capsule_group]]
        accordion = true
        accordion_direction = "start"
        border_width = 0.0
        enabled = true
        fill = "surface_container"
        id = "g1"
        members = [ "cat", "cpu", "ram", "sysmon" ]
        opacity = 0.0
        padding = 0.0

    [bar.lyrics]
    auto_hide_delay_ms = 300
    background_opacity = 0.72999998368322849
    border = "secondary"
    border_width = 2.5
    center = [ "lyrics" ]
    enabled = true
    end = []
    hover_highlight = false
    margin_edge = 6
    margin_ends = 400
    padding = 11
    radius = 13
    reserve_space = false
    show_on_workspace_switch = false
    start = []

[battery]
warning_threshold = 30

[brightness]
scheduled_night_brightness = 0.0

[calendar]
enabled = true

    [calendar.account.aniversarios]
    name = "aniversários"
    type = "google"

    [calendar.account.faculdade]
    name = "faculdade"
    type = "google"

    [calendar.account.pessoal]
    name = "luca"
    type = "google"

[control_center]
hidden_tabs = [ "monitor", "bluetooth" ]
show_shortcut_labels = false

    [[control_center.shortcuts]]
    type = "wifi"

    [[control_center.shortcuts]]
    type = "mic_mute"

    [[control_center.shortcuts]]
    type = "caffeine"

    [[control_center.shortcuts]]
    type = "nightlight"

    [[control_center.shortcuts]]
    type = "notification"

    [[control_center.shortcuts]]
    type = "power_profile"

[desktop_widgets]
schema_version = 2
widget_order = [ "desktop-widget-0000000000000001", "desktop-widget-0000000000000002" ]

    [desktop_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [desktop_widgets.widget.desktop-widget-0000000000000001]
    box_height = 400.0
    box_width = 672.0
    cx = 331.0
    cy = 568.0
    output = "eDP-1"
    placement_height = 768.0
    placement_width = 1366.0
    rotation = 0.0
    type = "audio_visualizer"

