[nightlight]
enabled = true
temperature_night = 4700

[notification]
background_opacity = 0.79999998211860657
border_color = "tertiary"
border_width = 3.5
filter_order = [ "filter" ]
history_retention_hours = 12
newest_on_edge = true
offset_x = 11
offset_y = 11
position = "bottom_right"
show_actions = false
show_app_name = false
width = 400

    [notification.filter.filter]
    allow_permanent = true
    bypass_dnd = false
    enabled = true
    match_content = ".*"
    override_duration = 3000
    play_sound = true
    save_history = true
    show_toast = true

[osd]
background_opacity = 0.79999998211860657
border_color = "primary"
border_width = 2.5
offset_x = 11
offset_y = 11
position = "bottom_right"

    [osd.kinds]
    media = false

[plugin_settings."ahmedhossamdev/sticky-notes"]
panel_placement = "floating"

[plugin_settings."ashur-d/wallpaper-widget"]
close_on_apply = true
hub_position = "auto"
notify_on_change = false

[plugin_settings."dotnetrob/cat"]
panel_placement = "floating"

[plugin_settings."h465855hgg/lyrics"]
selector_placement = "floating"

[plugin_settings."ishan0121/wallpaper-deck"]
include_wallhaven_downloads = false
panel_padding_offset = 19
preview_fit = "contain"
scan_subdirectories = false
wallpaper_dir = "/home/luca/Imagens/wallpaper"

[plugin_settings."nightwatch75/file-search"]
panel_placement = "floating"

[plugin_settings."vn1k/icons"]
manager_placement = "floating"

[plugins]
enabled = [
    "h465855hgg/lyrics",
    "aristides/udiskie",
    "dotnetrob/cat",
    "ashur-d/wallpaper-widget",
    "0b10headedcalf/obsidian-vault-switcher"
]

    [[plugins.source]]
    kind = "git"
    name = "official"

    [[plugins.source]]
    kind = "git"
    name = "community"

    [[plugins.source]]
    enabled = false
    kind = "path"
    location = "/home/luca/.config/noctalia"
    name = "plugins"

[shell]
app_icon_color = "primary"
avatar_path = "/home/luca/Imagens/coisas importantes/perfil.jpg"
circular_avatar = false
font_family = "Noto Serif"
lang = "en-GB"
password_style = "random"
polkit_agent = true
screen_time_enabled = true
settings_window_translucent = true
show_close_buttons = false

    [shell.animation]
    speed = 1.5000000223517418

    [shell.launcher]
    category_icons_only = true
    default_view = "all"
    show_settings_button = false
    width = 680

        [shell.launcher.panels]
        ignored = [
            "polkit",
            "setup-wizard",
            "test",
            "launcher",
            "clipboard",
            "wallpaper",
            "dotnetrob/cat:panel",
            "tray-drawer",
            "session"
        ]

        [shell.launcher.providers.panels]
        global = true

        [shell.launcher.providers.session]
        global = false

    [shell.panel]
    border_color = "primary"
    border_width = 2.5
    control_center_placement = "floating"
    control_center_position = "center"
    floating_offset = 11
    polkit_position = "auto"
    session_placement = "floating"
    transparency_mode = "soft"
    wallpaper_placement = "floating"
    wallpaper_show_names = false

    [shell.screenshot]
    confirm_region = true
    save_to_file = false
    show_cursor = true

    [[shell.session.actions]]
    action = "lock"
    countdown_seconds = 0.0
    enabled = true
    shortcut = "1"
    variant = "default"

    [[shell.session.actions]]
    action = "logout"
    countdown_seconds = 0.0
    enabled = true
    shortcut = "2"
    variant = "default"

    [[shell.session.actions]]
    action = "reboot"
    countdown_seconds = 0.0
    enabled = true
    shortcut = "4"
    variant = "default"

    [[shell.session.actions]]
    action = "command"
    command = "systemctl reboot --firmware-setup"
    countdown_seconds = 0.0
    enabled = true
    label = "UEFI"
    variant = "secondary"

    [[shell.session.actions]]
    action = "shutdown"
    countdown_seconds = 0.0
    enabled = true
    shortcut = "5"
    variant = "destructive"

[theme]
builtin = "Nord"
community_palette = "Catppuccin Mocha Sapphire"
source = "wallpaper"
wallpaper_scheme = "m3-content"

    [theme.templates]
    builtin_ids = [ "alacritty", "btop", "foot", "gtk3", "gtk4", "ghostty", "helix", "niri", "qt" ]
    community_ids = [ "qutebrowser", "discord", "obsidian", "zed", "prismlauncher", "fastfetch", "superfile" ]

        [theme.templates.user.obsidian1_extra]
        input_path = "/home/luca/.config/noctalia/Obsidian/obsidian.css"
        output_path = "/home/luca/Documentos/obsidian/obsidian/Occhiolism/.obsidian/snippets/noctalia.css"

        [theme.templates.user.obsidian_extra]
        input_path = "/home/luca/.config/noctalia/Obsidian/obsidian.css"
        output_path = "/home/luca/Documentos/obsidian/obsidian/Vellichor/.obsidian/snippets/noctalia.css"

        [theme.templates.user.terminal-sequences]
        enabled = true
        input_path = "~/.config/noctalia/templates/terminal-sequences"
        output_path = "~/.cache/terminal-sequences"
        post_hook = "tee /dev/pts/[0-9]* < ~/.cache/terminal-sequences > /dev/null"

[wallpaper]
directory = "/home/luca/Imagens/wallpaper"
transition = [ "diamond", "disc", "golden", "honeycomb", "melt", "pixel", "stripes", "vortex", "wipe" ]

    [wallpaper.automation]
    enabled = true

    [wallpaper.default]
    path = "/home/luca/Imagens/wallpaper/miku.jpg"

    [wallpaper.last]
    path = "/home/luca/Imagens/wallpaper/factory.jpg"

    [wallpaper.monitors.HDMI-A-1]
    path = "/home/luca/Imagens/wallpaper/frireren2.png"

    [wallpaper.monitors.eDP-1]
    path = "/home/luca/Imagens/wallpaper/factory.jpg"

[widget.active_window]
capsule_border = "secondary"
max_length = 213
min_length = 0

[widget.battery]
color = "primary"
display_mode = "graphic"
hide_when_plugged = true
show_label = false

[widget.cat]
cat_color = "on_surface_variant"
cat_color_mode = "custom"
cat_size = 29
show_tooltip = false
type = "dotnetrob/cat:cat"

[widget.cat_2]
capsule_border = "secondary"
poll_interval = 1
type = "dotnetrob/cat:cat"

[widget.clock]
color = "secondary"

[widget.cpu]
show_value = false

[widget.lyrics]
char_width = 14
display_mode = "lyrics"
double_line_auto_fit = true
enable_scroll = false
force_karaoke = true
gradient = true
hide_when_no_lyrics = false
interactive = false
karaoke_active_color = "#FFFFFF"
max_chars = 39
settings_page = "scroll"
show_artist = false
show_cover = false
show_glyph = false
show_romanization = true
show_translation = true
text_alignment = "center"
type = "h465855hgg/lyrics:lyrics"

[widget.lyrics_2]
display_mode = "lyrics"
enable_scroll = false
enabled = false
force_karaoke = true
gradient = true
selector_enabled = false
settings_page = "appearance"
text_alignment = "center"
type = "h465855hgg/lyrics:lyrics"

[widget.media]
capsule_border = "secondary"
color = "on_surface_variant"
hide_artist = true
hide_when_no_media = true
max_length = 204
min_length = 45

    [widget.media.actions]
    left = "exec noctalia msg bar-toggle lyrics"
    middle = "media toggle"
    right = "panel-toggle control-center media"

[widget.network]
show_label = false

[widget.privacy]
active_color = "#F10011"
capsule_border = "tertiary"
hide_inactive = true
icon_spacing = 2

[widget.ram]
show_value = false

[widget.status]
hide_when_empty = true
type = "aristides/udiskie:status"

[widget.status_2]
hide_when_empty = true
type = "aristides/udiskie:status"

[widget.sysmon]
show_value = false

[widget.taskbar]
active_indicator_color = "tertiary"
enabled = false

[widget.temp]
show_value = false

[widget.tray]
capsule_border = "secondary"

[widget.weather]
color = "primary"
show_condition = false
show_temperature = false

[widget.workspaces]
active_pill_size = 1.7000000000000002
