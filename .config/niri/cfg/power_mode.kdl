// Esse arquivo controla o que vai ser ativado / desativado quando quiser poupar bateria
// Algumas das janelas precisam ser reiniciadas para pegar os efeitos da mudança (tipo o foot)

animations {
	off
}
layout {
	shadow {
		off
	}
}
blur {
	off
}

window-rule{
	background-effect {
		blur false
		xray true
	}
	opacity 0.99
}
