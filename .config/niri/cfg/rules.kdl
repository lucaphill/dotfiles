// ============================================================
// Rules apply to all windows
// ============================================================
window-rule {
    geometry-corner-radius 10 // Set every window radius to 17
    clip-to-geometry true
}

window-rule {
    background-effect {
        blur true
        xray true // more efficient
    }
}

// ============================================================
// Rules by app
// ============================================================

// -- steam --
// if you use steam you will probably like these
window-rule {
    match app-id="steam"
    exclude title=r"^[Ss]team$"
    open-floating true
}
window-rule {
    match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// -- nautilus --
window-rule {
    match app-id="org.gnome.Nautilus"
    default-column-width { fixed 683; }
    default-window-height { fixed 700; }
}

// -- zen --
window-rule {
    match app-id="zen" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

// submodulos do zen para coisas especificas
// -- zen --
window-rule {
    match app-id="zen" title="(?i)^(meet|whatsapp)"
    block-out-from "screen-capture"
}
window-rule {
    match app-id="zen" title="(?i)^($docs.google.com/spreadsheets$)"
    block-out-from "screen-capture"
}


// -- gnome calculator --
window-rule {
    match app-id="org.gnome.Calculator" title="^Calculadora$"
    open-floating true
    default-column-width { fixed 360; }
    default-window-height { fixed 616; }
}

// -- vesktop --
window-rule {
    match app-id="vesktop"
    open-maximized true
}

// -- proton pass --
window-rule {
    match app-id="proton-pass"
    block-out-from "screen-capture"
}
// -- blender --
window-rule {
    match app-id="blender"
   	open-maximized true
}
// ============================================================
// screencast
// ============================================================

window-rule {
    match is-window-cast-target=true
    focus-ring {
        active-color "#e3000b"
        inactive-color "#e3000b"
    }
    border {
        inactive-color "#e3000b"
    }
    tab-indicator {
        active-color "#871e1d"
        inactive-color "#871e1d"
    }
}

// ============================================================
// Noctalia
// ============================================================

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
        // blur false
    }
}

layer-rule {
    match namespace="^noctalia-(notification)$"
    block-out-from "screen-capture"
    background-effect {
        xray false
        // blur false
    }
}

// wallpaper to all workspaces
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}
