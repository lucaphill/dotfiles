
/* apply to all popups, dosent work quite well in some apps
window-rule {
    popups {
        geometry-corner-radius 17
        opacity 0.8
        background-effect {
            blur true
        }
    }
}
*/

// -- nautilus --
window-rule {
    match app-id="^org.gnome.Nautilus"
    block-out-from "screencast"
    opacity 0.85
    draw-border-with-background false
    popups {
        background-effect {
            blur true
        }
    }
}

// -- mousepad --
window-rule {
    match app-id="^org.xfce.mousepad"
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// -- zed --
window-rule {
    match app-id="^dev.zed.Zed"
    opacity 0.99
    draw-border-with-background false
}

// -- obsidian --
window-rule {
    match app-id="^md.obsidian.Obsidian"
    opacity 0.95
    draw-border-with-background false
}

// -- configurações --
window-rule {
    match app-id="^dev.noctalia.Noctalia"
	scroll-factor 2
    draw-border-with-background false
}

