layout {

    focus-ring {
        active-color   "#c9c5cc"
        inactive-color "#141314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c9c5cc"
        inactive-color "#141314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c9c5cc"
        inactive-color "#18171c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c9c5cc80"
    }
}

recent-windows {
    highlight {
        active-color "#c9c5cc"
        urgent-color "#ffb4ab"
    }
}
