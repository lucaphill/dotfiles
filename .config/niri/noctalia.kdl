layout {

    focus-ring {
        active-color   "#a2caf5"
        inactive-color "#121416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a2caf5"
        inactive-color "#121416"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a2caf5"
        inactive-color "#6c94bc"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a2caf580"
    }
}

recent-windows {
    highlight {
        active-color "#a2caf5"
        urgent-color "#ffb4ab"
    }
}
