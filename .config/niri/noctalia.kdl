layout {

    focus-ring {
        active-color   "#ece276"
        inactive-color "#14140d"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ece276"
        inactive-color "#14140d"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ece276"
        inactive-color "#cfc65d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ece27680"
    }
}

recent-windows {
    highlight {
        active-color "#ece276"
        urgent-color "#ffb4ab"
    }
}
