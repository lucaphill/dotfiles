layout {

    focus-ring {
        active-color   "#bac8dc"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bac8dc"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bac8dc"
        inactive-color "#162332"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bac8dc80"
    }
}

recent-windows {
    highlight {
        active-color "#bac8dc"
        urgent-color "#ffb4ab"
    }
}
