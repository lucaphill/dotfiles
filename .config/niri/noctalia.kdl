layout {

    focus-ring {
        active-color   "#fbbb59"
        inactive-color "#17130c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#fbbb59"
        inactive-color "#17130c"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#fbbb59"
        inactive-color "#ce9335"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#fbbb5980"
    }
}

recent-windows {
    highlight {
        active-color "#fbbb59"
        urgent-color "#ffb4ab"
    }
}
