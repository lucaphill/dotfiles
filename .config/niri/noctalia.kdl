layout {

    focus-ring {
        active-color   "#a6caf3"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a6caf3"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a6caf3"
        inactive-color "#2a4f72"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a6caf380"
    }
}

recent-windows {
    highlight {
        active-color "#a6caf3"
        urgent-color "#ffb4ab"
    }
}
