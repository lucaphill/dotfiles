layout {

    focus-ring {
        active-color   "#afcadb"
        inactive-color "#121314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#afcadb"
        inactive-color "#121314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#afcadb"
        inactive-color "#8faaba"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#afcadb80"
    }
}

recent-windows {
    highlight {
        active-color "#afcadb"
        urgent-color "#ffb4ab"
    }
}
