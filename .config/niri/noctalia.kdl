layout {

    focus-ring {
        active-color   "#c2c6d4"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c2c6d4"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c2c6d4"
        inactive-color "#555a66"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c2c6d480"
    }
}

recent-windows {
    highlight {
        active-color "#c2c6d4"
        urgent-color "#ffb4ab"
    }
}
