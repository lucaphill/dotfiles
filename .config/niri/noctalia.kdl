layout {

    focus-ring {
        active-color   "#ccbeff"
        inactive-color "#14121b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ccbeff"
        inactive-color "#14121b"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ccbeff"
        inactive-color "#633adb"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ccbeff80"
    }
}

recent-windows {
    highlight {
        active-color "#ccbeff"
        urgent-color "#ffb4ab"
    }
}
