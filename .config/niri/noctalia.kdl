layout {

    focus-ring {
        active-color   "#d7c85e"
        inactive-color "#15130d"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d7c85e"
        inactive-color "#15130d"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d7c85e"
        inactive-color "#9f922e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d7c85e80"
    }
}

recent-windows {
    highlight {
        active-color "#d7c85e"
        urgent-color "#ffb4ab"
    }
}
