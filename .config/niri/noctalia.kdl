layout {

    focus-ring {
        active-color   "#c7cc77"
        inactive-color "#14140e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c7cc77"
        inactive-color "#14140e"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c7cc77"
        inactive-color "#919647"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c7cc7780"
    }
}

recent-windows {
    highlight {
        active-color "#c7cc77"
        urgent-color "#ffb4ab"
    }
}
