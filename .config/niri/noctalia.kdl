layout {

    focus-ring {
        active-color   "#b5e2d9"
        inactive-color "#121413"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b5e2d9"
        inactive-color "#121413"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b5e2d9"
        inactive-color "#9ac6bd"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b5e2d980"
    }
}

recent-windows {
    highlight {
        active-color "#b5e2d9"
        urgent-color "#ffb4ab"
    }
}
